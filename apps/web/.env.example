# ──────────────────────────────────────────────────────────
# Let's Go Tutors Web — build-time variables (baked into the bundle, so
# only put PUBLIC values here). Set the same keys in Railway/Vercel.
# ──────────────────────────────────────────────────────────

# Full URL of the API including /api, e.g. https://lgt-api.up.railway.app/api
# Leave unset in local dev (Vite proxies /api to localhost:4000).
VITE_API_URL=

# Supabase (Project Settings → API → anon/publishable key — never the service role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

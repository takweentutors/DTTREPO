# ──────────────────────────────────────────────────────────
# Let's Go Tutors API — Environment Variables
# Copy to .env for local dev; set the same keys in Railway → Variables.
# NEVER commit .env — only .env.example is tracked by git.
# ──────────────────────────────────────────────────────────

# Database (Supabase Postgres connection string, or Railway Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/letsgotutors"

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server
# Comma-separated list of allowed web origins
CORS_ORIGIN="http://localhost:5173"
# Where Stripe/Zoom redirect users back to (defaults to first CORS_ORIGIN)
FRONTEND_URL="http://localhost:5173"
PORT=4000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=
STRIPE_PRICE_PLATINUM_PATH=
STRIPE_PRICE_GOLD_EDGE=
STRIPE_PRICE_SILVER_ADVANTAGE=
STRIPE_PRICE_BRONZE_BOOST=
STRIPE_PRICE_FOUNDATIONAL_FIXES=
STRIPE_PRICE_FOUNDATIONAL_FOCUS=

# AI chatbot (server-side only)
GEMINI_API_KEY=

# Zoom (optional)
# ZOOM_WEBHOOK_SECRET_TOKEN=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_ACCOUNT_ID=

# Google Drive (optional — for recording upload)
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_DRIVE_FOLDER_ID=

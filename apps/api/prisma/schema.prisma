generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

enum BookingStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  COMPLETED
}

enum SessionStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
}

enum ApplicationStatus {
  NEW
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum TicketCategory {
  PAYMENTS
  SCHEDULING
  TUTOR_ISSUES
  TECHNICAL
  GENERAL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile   StudentProfile?
  tutorProfile     TutorProfile?
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  refreshToken     String?

  // Parent ↔ Student links (many-to-many)
  parentLinks       ParentStudentLink[] @relation("ParentUser")
  studentLinks      ParentStudentLink[] @relation("StudentUser")

  // NEW: 1:1 Mapping to Stripe
  stripeCustomerId String?  @unique

  // Bookings made by this user (parent or student)
  bookings          Booking[]

  // Admin: applications reviewed
  reviewedApplications TutorApplication[] @relation("ApplicationReviewer")

  // Support tickets
  createdTickets       SupportTicket[]    @relation("TicketCreator")
  assignedTickets      SupportTicket[]    @relation("TicketAssignee")
  ticketReplies        TicketReply[]      @relation("TicketReplier")
}

model StudentProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearGroup   String?
  targetExams String?
  timezone    String  @default("Europe/London")

  sessions  Session[]
  progress  Progress[]
}

model TutorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  hourlyRate         Float?
  verificationStatus VerificationStatus @default(PENDING)

  subjects     TutorSubject[]
  sessions     Session[]
  availability TutorAvailability[]
}

model Subject {
  id   String @id @default(uuid())
  name String @unique

  tutorSubjects TutorSubject[]
  sessions      Session[]
  progress      Progress[]
}

model TutorSubject {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, subjectId])
  @@index([subjectId])
}

model Session {
  id          String        @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorId     String
  tutor       TutorProfile  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  status      SessionStatus @default(UPCOMING)
  meetingLink   String?
  zoomMeetingId String?
  zoomJoinUrl   String?
  zoomPassword  String?
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([studentId])
  @@index([tutorId])
  @@index([subjectId])
}

model Message {
  id         String    @id @default(uuid())
  fromUserId String
  fromUser   User      @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User      @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@index([fromUserId])
  @@index([toUserId])
}

model Progress {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  metricType String
  value      Float
  recordedAt DateTime       @default(now())
}

model ParentStudentLink {
  id         String         @id @default(uuid())
  parentId   String
  parent     User           @relation("ParentUser", fields: [parentId], references: [id])
  studentId  String
  student    User           @relation("StudentUser", fields: [studentId], references: [id])
  
  @@unique([parentId, studentId])
}

model Booking {
  id                String        @id @default(uuid())
  userId            String                          // links to the paying parent/student
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSessionId   String        @unique           // Stripe Checkout Session ID
  stripeCustomerId  String?                         // Stripe Customer ID (for recurring lookups)
  stripePaymentIntentId String?                     // for receipt/invoice retrieval

  tier              String                          // e.g. "Platinum Path"
  subject           String                          // e.g. "GCSE Maths"
  status            BookingStatus @default(ACTIVE)

  amountPaid        Int                             // in pence (Stripe uses minor units)
  currency          String        @default("gbp")

  paidAt            DateTime      @default(now())
  lastPaymentAt     DateTime?                       // updated on recurring invoice.paid
  cancelledAt       DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
}

model TutorAvailability {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  dayOfWeek      Int          // 0=Monday ... 6=Sunday
  startTime      String       // "09:00"
  endTime        String       // "17:00"

  @@index([tutorProfileId])
}

model TutorApplication {
  id               String            @id @default(uuid())

  applicantName    String
  applicantEmail   String
  phone            String?

  education        String
  experience       String
  subjectExpertise String[]
  availability     String
  cvUrl            String?
  coverLetter      String?

  status           ApplicationStatus @default(NEW)
  reviewerId       String?
  reviewer         User?             @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  interviewNotes   String?
  interviewDate    DateTime?
  rejectionReason  String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([applicantEmail])
}

model SupportTicket {
  id          String         @id @default(uuid())

  userId      String
  user        User           @relation("TicketCreator", fields: [userId], references: [id])

  subject     String
  body        String
  category    TicketCategory @default(GENERAL)
  status      TicketStatus   @default(NEW)

  assigneeId  String?
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])

  resolvedAt  DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  replies     TicketReply[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([assigneeId])
}

model TicketReply {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("TicketReplier", fields: [userId], references: [id])
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}
